<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_dock_bg"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/dialog_picker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выбор параметра"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/dialog_picker_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите нужное значение и нажмите [Назад] для сохранения"
            android:textColor="#88FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialog_picker_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:maxHeight="380dp" />
    </LinearLayout>

</FrameLayout>
