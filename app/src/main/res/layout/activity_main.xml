<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Фоновый постер Top Shelf -->
    <ImageView
        android:id="@+id/hero_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_studio" />

    <!-- 2. Динамическая подсветка Ambient Glow -->
    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55" />

    <!-- 3. Градиент глубины tvOS снизу -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_gradient_overlay" />

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <RelativeLayout
        android:id="@+id/home_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Верхний бар -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="36dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apple TV"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="14" />

            <FrameLayout
                android:id="@+id/btn_launcher_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="20dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/btn_launcher_settings"
                android:nextFocusRight="@id/btn_launcher_settings"
                android:background="@drawable/pill_button_selector">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextClock
                    android:id="@+id/main_text_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#EEFFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_date_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <!-- Нижний парящий Dock tvOS -->
        <LinearLayout
            android:id="@+id/dock_layout_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/glass_dock_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_dock_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dock_recycler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </FrameLayout>

            <!-- Линии нижней полки tvOS -->
            <LinearLayout
                android:id="@+id/peeking_shelf"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center">

                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_blue" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_purple" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_orange" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_green" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_pink" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- КАТАЛОГ ВСЕХ ПРИЛОЖЕНИЙ -->
    <FrameLayout
        android:id="@+id/app_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B806070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Все приложения"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для выхода"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- ПАНЕЛЬ НАСТРОЕК -->
    <FrameLayout
        android:id="@+id/settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C406070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <ScrollView
                android:id="@+id/settings_scroll_view"
                android:layout_width="440dp"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settings_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- 1. Плитки -->
                    <FrameLayout
                        android:id="@+id/setting_item_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_tiles"
                        android:nextFocusRight="@id/setting_item_tiles"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_tiles_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Плитки главного экрана"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_tiles_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="›"
                            android:textColor="#88FFFFFF"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <!-- 2. Звуковые эффекты tvOS -->
                    <FrameLayout
                        android:id="@+id/setting_item_sound"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_sound"
                        android:nextFocusRight="@id/setting_item_sound"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_sound_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Звуковые эффекты tvOS"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_sound_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Включены"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 3. Эмбиент -->
                    <FrameLayout
                        android:id="@+id/setting_item_ambient"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_ambient"
                        android:nextFocusRight="@id/setting_item_ambient"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_ambient_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Эмбиент-подсветка"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_ambient_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Стандарт (55%)"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 4. Размер плиток -->
                    <FrameLayout
                        android:id="@+id/setting_item_tiles_size"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_tiles_size"
                        android:nextFocusRight="@id/setting_item_tiles_size"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_size_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Размер и масштаб плиток"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_size_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Стандарт tvOS"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 5. Часы -->
                    <FrameLayout
                        android:id="@+id/setting_item_clock"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_clock"
                        android:nextFocusRight="@id/setting_item_clock"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_clock_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Часы и дата"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_clock_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="24-часовой"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 6. Заставка -->
                    <FrameLayout
                        android:id="@+id/setting_item_screensaver"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_screensaver"
                        android:nextFocusRight="@id/setting_item_screensaver"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_saver_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Заставка и режим сна"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_saver_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Через 5 мин"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 7. Автозапуск -->
                    <FrameLayout
                        android:id="@+id/setting_item_autostart"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_autostart"
                        android:nextFocusRight="@id/setting_item_autostart"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_autostart_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Быстрый запуск при старте"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_autostart_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Главный экран"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 8. Сброс порядка -->
                    <FrameLayout
                        android:id="@+id/setting_item_reset_order"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_reset_order"
                        android:nextFocusRight="@id/setting_item_reset_order"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_reset_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Сбросить порядок ярлыков"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 9. Восстановить -->
                    <FrameLayout
                        android:id="@+id/setting_item_restore_hidden"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_restore_hidden"
                        android:nextFocusRight="@id/setting_item_restore_hidden"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_restore_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Восстановить скрытые программы"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 10. Параметры Android TV -->
                    <FrameLayout
                        android:id="@+id/setting_item_system"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_system"
                        android:nextFocusRight="@id/setting_item_system"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_sys_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Параметры Android ТВ"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_sys_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="⚙"
                            android:textColor="#88FFFFFF"
                            android:textSize="15sp" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="50dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/glass_dock_bg"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/settings_preview_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="44sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple TV Лаунчер"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/settings_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выберите раздел для детальной настройки интерфейса и эффектов."
                    android:textColor="#99FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ЭКРАН УПРАВЛЕНИЯ ПЛИТКАМИ -->
    <FrameLayout
        android:id="@+id/tiles_manager_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D406070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="40dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Плитки главного экрана"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Включайте или отключайте приложения в нижней полке Dock"
                        android:textColor="#88FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для сохранения"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles_manager_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- ЗАСТАВКА SCREENSAVER -->
    <FrameLayout
        android:id="@+id/screensaver_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/screensaver_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_poster_space" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="48dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/saver_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="h:mm a"
                android:textColor="#FFFFFF"
                android:textSize="60sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="20" />

            <TextView
                android:id="@+id/saver_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="2dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="14" />
        </LinearLayout>
    </FrameLayout>

    <!-- 6. ВЫЕЗЖАЮЩИЙ ЦЕНТР УПРАВЛЕНИЯ APPLE TVOS (CONTROL CENTER) -->
    <FrameLayout
        android:id="@+id/control_center_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/control_center_panel"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/glass_dock_bg"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/settings_item_selector">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пункт управления"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cc_time_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21:45"
                        android:textColor="#88FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад]"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Wi-Fi -->
                    <FrameLayout
                        android:id="@+id/cc_card_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="📶"
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="36dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cc_wifi_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wi-Fi сеть"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cc_wifi_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Подключено"
                                android:textColor="#88FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- 2. Громкость -->
                    <FrameLayout
                        android:id="@+id/cc_card_volume"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/cc_vol_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="🔊"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="38dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Громкость [◀ ▶]"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cc_volume_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50%"
                                android:textColor="#34C759"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- 3. Заставка -->
                    <FrameLayout
                        android:id="@+id/cc_card_screensaver"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="🕹"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="36dp"
                            android:text="Заставка Aerial"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 4. Таймер сна -->
                    <FrameLayout
                        android:id="@+id/cc_card_sleeptimer"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="⏱"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="36dp"
                            android:text="Таймер сна"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/cc_sleeptimer_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Выкл"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 5. Питание -->
                    <FrameLayout
                        android:id="@+id/cc_card_power"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="⏻"
                            android:textColor="#FF3B30"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="36dp"
                            android:text="Спящий режим ТВ"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
