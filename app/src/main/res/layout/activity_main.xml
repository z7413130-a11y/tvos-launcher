<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/hero_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_studio" />

    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_gradient_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="36dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apple TV"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14" />

        <FrameLayout
            android:id="@+id/btn_launcher_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/pill_button_selector">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </FrameLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#EEFFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_layout_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="26dp">

        <FrameLayout
            android:id="@+id/glass_dock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_dock_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock_recycler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/peeking_shelf"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_blue" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_purple" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_orange" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_green" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_pink" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/app_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6050508"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="48dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Все приложения"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для выхода"
                    android:textColor="#88FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0050508"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="50dp"
            android:paddingBottom="50dp">

            <LinearLayout
                android:layout_width="440dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Настройки"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="28dp" />

                <FrameLayout
                    android:id="@+id/setting_item_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tv_setting_tiles_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:text="Плитки главного экрана"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_setting_tiles_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:text="›"
                        android:textColor="#88FFFFFF"
                        android:textSize="22sp" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/setting_item_reset_order"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tv_setting_reset_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:text="Сбросить порядок ярлыков"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/setting_item_restore_hidden"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tv_setting_restore_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:text="Восстановить скрытые приложения"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/setting_item_system"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/tv_setting_sys_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:text="Параметры Android ТВ"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_setting_sys_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:text="⚙"
                        android:textColor="#88FFFFFF"
                        android:textSize="18sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="70dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/glass_dock_bg"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/settings_preview_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="48sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple TV Лаунчер"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/settings_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выберите раздел для настройки внешнего вида, списка плиток и параметров домашнего экрана."
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/tiles_manager_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2050508"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="70dp"
            android:paddingEnd="70dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Плитки главного экрана"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Включайте или отключайте отображение приложений в нижней полке Dock"
                        android:textColor="#88FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для сохранения"
                    android:textColor="#88FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles_manager_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
