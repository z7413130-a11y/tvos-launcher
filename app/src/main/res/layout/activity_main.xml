<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Фоновый постер Top Shelf -->
    <ImageView
        android:id="@+id/hero_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_studio" />

    <!-- 2. Динамическая подсветка Ambient Glow -->
    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55" />

    <!-- 3. Градиент глубины tvOS снизу -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_gradient_overlay" />

    <!-- ГЛАВНЫЙ ЭКРАН -->
    <RelativeLayout
        android:id="@+id/home_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ВЕРХНЯЯ СТАТУСНАЯ СТРОКА (СПРАВА В УГЛУ) -->
        <LinearLayout
            android:id="@+id/top_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/glass_dock_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/btn_open_control_center"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/pill_button_selector">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_control_center" />
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#22FFFFFF"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextClock
                    android:id="@+id/main_text_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_date_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#22FFFFFF"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp" />

            <FrameLayout
                android:id="@+id/btn_launcher_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/pill_button_selector">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⚙"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Заголовок активного приложения слева -->
        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="56dp"
            android:layout_marginTop="36dp"
            android:text="Apple TV"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14" />

        <!-- Нижний парящий Dock tvOS -->
        <LinearLayout
            android:id="@+id/dock_layout_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <FrameLayout
                android:id="@+id/glass_dock_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_dock_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dock_recycler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/peeking_shelf"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center">

                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_blue" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_purple" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_orange" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_green" />
                <View android:layout_width="48dp" android:layout_height="5dp" android:layout_marginHorizontal="4dp" android:background="@drawable/shape_peeking_pill_pink" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- КАТАЛОГ ВСЕХ ПРИЛОЖЕНИЙ -->
    <FrameLayout
        android:id="@+id/app_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B806070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Все приложения"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для выхода"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- ПАНЕЛЬ НАСТРОЕК -->
    <FrameLayout
        android:id="@+id/settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C406070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <ScrollView
                android:id="@+id/settings_scroll_view"
                android:layout_width="440dp"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settings_items_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройки"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- 1. Плитки -->
                    <FrameLayout
                        android:id="@+id/setting_item_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_tiles"
                        android:nextFocusRight="@id/setting_item_tiles"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_tiles_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Плитки главного экрана"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_tiles_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="›"
                            android:textColor="#88FFFFFF"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <!-- 2. Звуки -->
                    <FrameLayout
                        android:id="@+id/setting_item_sound"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_sound"
                        android:nextFocusRight="@id/setting_item_sound"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_sound_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Звуковые эффекты tvOS"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_sound_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Включены"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 3. Эмбиент -->
                    <FrameLayout
                        android:id="@+id/setting_item_ambient"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_ambient"
                        android:nextFocusRight="@id/setting_item_ambient"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_ambient_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Эмбиент-подсветка"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_ambient_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Стандарт (55%)"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 4. Размер -->
                    <FrameLayout
                        android:id="@+id/setting_item_tiles_size"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_tiles_size"
                        android:nextFocusRight="@id/setting_item_tiles_size"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_size_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Размер и масштаб плиток"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_size_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Стандарт tvOS"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 5. Часы -->
                    <FrameLayout
                        android:id="@+id/setting_item_clock"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_clock"
                        android:nextFocusRight="@id/setting_item_clock"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_clock_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Часы и дата"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_clock_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="24-часовой"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 6. Заставка -->
                    <FrameLayout
                        android:id="@+id/setting_item_screensaver"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_screensaver"
                        android:nextFocusRight="@id/setting_item_screensaver"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_saver_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Заставка и режим сна"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_saver_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Через 5 мин"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 7. Автозапуск -->
                    <FrameLayout
                        android:id="@+id/setting_item_autostart"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_autostart"
                        android:nextFocusRight="@id/setting_item_autostart"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_autostart_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Быстрый запуск при старте"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_autostart_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="Главный экран"
                            android:textColor="#88FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- 8. Сброс -->
                    <FrameLayout
                        android:id="@+id/setting_item_reset_order"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_reset_order"
                        android:nextFocusRight="@id/setting_item_reset_order"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_reset_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Сбросить порядок ярлыков"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 9. Восстановить -->
                    <FrameLayout
                        android:id="@+id/setting_item_restore_hidden"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="8dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_restore_hidden"
                        android:nextFocusRight="@id/setting_item_restore_hidden"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_restore_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Восстановить скрытые программы"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 10. Системные -->
                    <FrameLayout
                        android:id="@+id/setting_item_system"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/setting_item_system"
                        android:nextFocusRight="@id/setting_item_system"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="18dp">

                        <TextView
                            android:id="@+id/tv_setting_sys_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:text="Параметры Android ТВ"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_setting_sys_arrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="⚙"
                            android:textColor="#88FFFFFF"
                            android:textSize="15sp" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="50dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/glass_dock_bg"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/settings_preview_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="44sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apple TV Лаунчер"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/settings_preview_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выберите раздел для детальной настройки интерфейса и эффектов."
                    android:textColor="#99FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ЭКРАН УПРАВЛЕНИЯ ПЛИТКАМИ -->
    <FrameLayout
        android:id="@+id/tiles_manager_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D406070B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:paddingTop="40dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Плитки главного экрана"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Включайте или отключайте приложения в нижней полке Dock"
                        android:textColor="#88FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[Назад] для сохранения"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles_manager_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <!-- ЗАСТАВКА SCREENSAVER -->
    <FrameLayout
        android:id="@+id/screensaver_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/screensaver_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_poster_space" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="48dp"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/saver_text_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="HH:mm"
                android:format12Hour="h:mm a"
                android:textColor="#FFFFFF"
                android:textSize="60sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="20" />

            <TextView
                android:id="@+id/saver_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="2dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="14" />
        </LinearLayout>
    </FrameLayout>

    <!-- 6. КОМПАКТНАЯ КАРТОЧКА ЦЕНТРА УПРАВЛЕНИЯ (ТОЧНАЯ КОПИЯ С ФОТО СПРАВА СБОКУ, РАЗМЕР 360DP) -->
    <FrameLayout
        android:id="@+id/control_center_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Правая мини-карточка ширина = 360dp, отступы сверху 64dp, справа 24dp -->
        <LinearLayout
            android:id="@+id/control_center_panel"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="64dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/glass_dock_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- РЯД 1: Выключение (слева) и Колонка Wi-Fi + Громкость (справа) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Выключение (110x110 dp) -->
                <FrameLayout
                    android:id="@+id/cc_card_power"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_power"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Выключение"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Правая колонка -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <!-- Плашка Wi-Fi (высота 50dp) -->
                    <FrameLayout
                        android:id="@+id/cc_card_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:src="@drawable/ic_wifi" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="26dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/cc_wifi_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wi-Fi сеть"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cc_wifi_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Подключено"
                                android:textColor="#88FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|end"
                            android:text="›"
                            android:textColor="#88FFFFFF"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <!-- Плашка Громкости (высота 50dp) -->
                    <FrameLayout
                        android:id="@+id/cc_card_volume"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/settings_item_selector"
                        android:paddingHorizontal="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_volume"
                                android:layout_marginEnd="8dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/shape_peeking_pill_blue" />

                            <TextView
                                android:id="@+id/cc_volume_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="83%"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- РЯД 2: Заставка Aerial и Таймер сна (высота 54dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Заставка Aerial -->
                <FrameLayout
                    android:id="@+id/cc_card_screensaver"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start"
                        android:src="@drawable/ic_screensaver" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="26dp"
                        android:text="Заставка Aerial"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:text="›"
                        android:textColor="#88FFFFFF"
                        android:textSize="18sp" />
                </FrameLayout>

                <!-- Таймер сна -->
                <FrameLayout
                    android:id="@+id/cc_card_sleeptimer"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/settings_item_selector"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|start"
                        android:src="@drawable/ic_timer" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:layout_marginStart="26dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Таймер сна"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/cc_sleeptimer_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Выкл"
                            android:textColor="#88FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:text="›"
                        android:textColor="#88FFFFFF"
                        android:textSize="18sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- РЯД 3: Спящий режим ТВ (высота 54dp) -->
            <FrameLayout
                android:id="@+id/cc_card_sleepmode"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/settings_item_selector"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical|start"
                    android:src="@drawable/ic_sleep" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="26dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Спящий режим ТВ"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выкл"
                        android:textColor="#88FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:text="›"
                    android:textColor="#88FFFFFF"
                    android:textSize="18sp" />
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
