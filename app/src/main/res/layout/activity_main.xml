<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/hero_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_poster_studio" />

    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.45" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_gradient_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="36dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apple TV"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14" />

        <FrameLayout
            android:id="@+id/btn_launcher_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="20dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/pill_button_selector">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </FrameLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#EEFFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_layout_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="26dp">

        <FrameLayout
            android:id="@+id/glass_dock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_dock_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dock_recycler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/peeking_shelf"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_blue" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_purple" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_orange" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_green" />
            <View android:layout_width="54dp" android:layout_height="6dp" android:layout_marginHorizontal="5dp" android:background="@drawable/shape_peeking_pill_pink" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/app_drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9050508"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="48dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Все приложения"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_close_drawer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нажмите [Назад] для выхода"
                    android:textColor="#88FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
